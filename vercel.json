{
  "trailingSlash": false,
  "regions": ["gru1"],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/producto/:slug", "destination": "/api/producto?slug=:slug" },
    { "source": "/categoria/:slug", "destination": "/api/categoria?slug=:slug" },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}