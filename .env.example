# ============================================================================
# Iguazú Marketplace — variables de entorno del FRONTEND (Vite)
# Copiá este archivo como `.env` y completá los valores reales.
# `.env` está en .gitignore: nunca se commitea.
# En producción (Vercel) se configuran en Settings → Environment Variables.
# ============================================================================

# URL del proyecto Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=

# Clave anon/public de Supabase (segura para el navegador)
VITE_SUPABASE_ANON_KEY=

# URL pública de la app (ej: http://localhost:5173 o la de Vercel)
VITE_APP_URL=

# Link de WhatsApp de atención (ej: https://wa.me/54...)
VITE_WHATSAPP_URL=

# ============================================================================
# Secretos de las Supabase Edge Functions — se configuran A MANO en el
# Dashboard de Supabase (Edge Functions → <función> → Secrets), NO van en .env
# ============================================================================

# Función create-payment:
#   MERCADOPAGO_ACCESS_TOKEN   Token de acceso de Mercado Pago
#   SITE_URL                   URL pública de la app para redirecciones

# Función create-quote:
#   CORREO_ARGENTINO_ENV       Entorno de la API de Correo Argentino (test | production)
#   CORREO_ARGENTINO_USER      Usuario de Correo Argentino
#   CORREO_ARGENTINO_PASSWORD  Contraseña de Correo Argentino

# Nota: SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase
# automáticamente en las Edge Functions; no hace falta declararlos.
